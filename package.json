{
  "name": "jda-moca-mcp",
  "version": "0.3.0",
  "description": "MCP server for MOCA / Blue Yonder (JDA) WMS: connect, run read-only queries, discover schema and commands, with encrypted reusable connection profiles.",
  "type": "module",
  "bin": {
    "jda-moca-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "files": [
    "build",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-resources.mjs",
    "watch": "tsc -w",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs",
    "coverage": "c8 node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@primno/dpapi": "^2.0.1",
    "fast-xml-parser": "^5.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "c8": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
